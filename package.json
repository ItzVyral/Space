{
  "name": "space",
  "productName": "Space",
  "version": "0.1.0",
  "description": "Application de design vectoriel 2D (Electron) — la simplicité de Figma, la complétude d'Illustrator/Affinity, le workflow Object/Edit Mode de Blender.",
  "main": "out/main/main.js",
  "author": {
    "name": "ItzVyral",
    "email": "msa.26@outlook.fr"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bin:deb": "npm run build && electron-builder --linux deb",
    "bin:rpm": "npm run build && electron-builder --linux rpm",
    "bin:appimage": "npm run build && electron-builder --linux AppImage",
    "bin:arch": "npm run build && ./scripts/build-arch-pkg.sh",
    "assets:dmg": "node scripts/render-dmg-assets.mjs",
    "bin:macos:arm": "npm run build && electron-builder --mac dmg --arm64",
    "bin:macos:x64": "npm run build && electron-builder --mac dmg --x64",
    "bin:win": "npm run build && electron-builder --win nsis",
    "bin:all": "npm run bin:deb && npm run bin:rpm && npm run bin:appimage && npm run bin:arch && npm run bin:macos:arm && npm run bin:macos:x64 && npm run bin:win"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0"
  }
}
